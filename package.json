{
  "name": "mini-tokyo-3d",
  "version": "4.1.0",
  "description": "A real-time 3D digital map of Tokyo's public transport system",
  "homepage": "https://minitokyo3d.com",
  "bugs": {
    "url": "https://github.com/nagix/mini-tokyo-3d/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nagix/mini-tokyo-3d.git"
  },
  "license": "MIT",
  "author": "Akihiko Kusanagi",
  "main": "dist/mini-tokyo-3d.cjs",
  "jsdelivr": "dist/mini-tokyo-3d.min.js",
  "unpkg": "dist/mini-tokyo-3d.min.js",
  "module": "dist/mini-tokyo-3d.esm.js",
  "style": "dist/mini-tokyo-3d.css",
  "files": [
    "dist/mini-tokyo-3d.*",
    "dist/assets",
    "src/"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs dist && run-s bundle copy-assets",
    "build-all": "node scripts/clean.mjs build && run-s build build-pages build-data docs",
    "build-data": "node scripts/build-data.mjs",
    "build-pages": "node scripts/build-pages.mjs && node scripts/gen-index.mjs prod",
    "bundle": "rollup -c",
    "clean": "node scripts/clean.mjs dist dev build",
    "copy-assets": "node scripts/copy-assets.mjs",
    "dev": "node scripts/clean.mjs dev && node scripts/gen-index.mjs && run-p -l dev:watch dev:serve",
    "dev:serve": "node scripts/serve.mjs",
    "dev:watch": "rollup -c rollup.config.dev.mjs -w",
    "docs": "vuepress build docs --no-cache",
    "docs:dev": "vuepress dev docs --no-cache",
    "lint": "eslint --cache . && sort-package-json --check",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@deck.gl/core": "^8.9.36",
    "@deck.gl/geo-layers": "^8.9.36",
    "@deck.gl/layers": "^8.9.36",
    "@deck.gl/mapbox": "^8.9.36",
    "@turf/along": "^7.4.0",
    "@turf/bearing": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/center-of-mass": "^7.4.0",
    "@turf/clean-coords": "^7.4.0",
    "@turf/destination": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/invariant": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/line-intersect": "^7.4.0",
    "@turf/line-slice": "^7.4.0",
    "@turf/meta": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "@turf/polygon-to-line": "^7.4.0",
    "@turf/truncate": "^7.4.0",
    "@turf/union": "^7.4.0",
    "comlink": "^4.4.2",
    "csscolorparser": "^1.0.3",
    "fflate": "^0.8.3",
    "geobuf": "^4.0.0",
    "gtfs-realtime-bindings": "^2.2.0",
    "japanese-holidays": "^1.0.10",
    "mapbox-gl": "~3.32.0",
    "mapbox-gl-animated-popup": "^0.4.0",
    "pbf": "^5.1.2",
    "suncalc": "^2.0.2",
    "swiper": "^12.2.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-strip": "^3.0.4",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/pluginutils": "^5.4.0",
    "dotenv": "^18.0.4",
    "eslint": "^10.11.0",
    "eslint-config-mourner": "^5.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.28",
    "postcss-import": "^17.0.0",
    "postcss-inline-svg": "^6.0.0",
    "rollup": "^4.63.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "serve-static": "^2.2.1",
    "sort-package-json": "^4.0.0",
    "vuepress": "^1.9.10",
    "vuepress-plugin-flexsearch": "^0.3.0"
  }
}
