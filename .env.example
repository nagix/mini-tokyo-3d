# Environment variables read by the dev server (`npm run dev`) and the
# deployment build (`npm run build-all`).
#
# Put the values you need into one of these git-ignored files:
#   .env               shared by both dev and deployment
#   .env.development   development only (npm run dev)
#   .env.production    deployment only (npm run build-all)
# Values in .env.<mode> take precedence over .env, and shell variables win over
# both. All are optional; unset (or empty) ones are simply skipped.

# Mapbox access token. The default token is domain-restricted and does not work
# on localhost, so a local token is required to display the base map. (shared)
MAPBOX_ACCESS_TOKEN=

# Access tokens for the data source APIs. (deployment)
MT3D_SECRET_ODPT=
MT3D_SECRET_CHALLENGE=

# Google Analytics measurement id. Leave empty to omit analytics. (deployment)
MT3D_GA_ID=

# Data URL. Set to "data" to use locally generated data (run `npm run build-data`
# first); leave empty to use the default remote data. (development)
MT3D_DATA_URL=

# Paths to built plugin files to load, one per plugin. Point each at the
# plugin's built file (e.g. its dist output). Unset plugins are omitted. (shared)
MT3D_PLUGIN_PRECIPITATION=
MT3D_PLUGIN_FIREWORKS=
MT3D_PLUGIN_LIVECAM=
MT3D_PLUGIN_PLATEAU=
MT3D_PLUGIN_GTFS=
